# ═══════════════════════════════════════════════════════════════════
# WattLab production — copia in `.env` nella stessa cartella sul VPS
# e compila ogni valore. NON committare mai il file .env compilato.
# ═══════════════════════════════════════════════════════════════════

# Il tuo dominio (senza https://)
DOMAIN=tuodominio.com

# Password del database — genera con: openssl rand -base64 32
POSTGRES_PASSWORD=

# Secret JWT — genera OGNUNO con: openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email admin (l'unica che vede la dashboard di gestione)
ADMIN_EMAIL=piana.richh@gmail.com

# Brevo (recupero password + verifica email) — API key da Settings → SMTP & API
BREVO_API_KEY=
SENDER_EMAIL=wattlab.support@gmail.com

# Verifica email obbligatoria al login (true/false).
# Tienilo false finché non hai testato l'invio email con Brevo.
REQUIRE_EMAIL_VERIFICATION=false

# Cookie sicuri (OBBLIGATORIO true in produzione — il server rifiuta di
# partire se è false con NODE_ENV=production)
COOKIE_SECURE=true
