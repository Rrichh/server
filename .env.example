# ═══ Config sviluppo locale ═══
# (in produzione i valori vengono dal file deploy/.env sul VPS — vedi DEPLOY.md)

PORT=3000
NODE_ENV=development

# ─── Database (Postgres locale per dev) ───
DATABASE_URL=postgresql://wattlab:devpass@localhost:5432/wattlab

# ─── Auth ───
JWT_ACCESS_SECRET=dev-only-secret-change-me-min-32-characters-long
JWT_REFRESH_SECRET=dev-only-refresh-secret-different-from-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── CORS (solo per dev: client su origin diverso dall'API) ───
# In produzione resta VUOTO: sito e API sono same-origin via Caddy.
CORS_ORIGIN=http://localhost:8080,null

# ─── Admin ───
ADMIN_EMAIL=piana.richh@gmail.com

# ─── Email transazionali (Brevo — recupero password + verifica email) ───
# Lascia vuoto per disabilitare l'invio (gli endpoint rispondono ok ma loggano warn)
BREVO_API_KEY=
SENDER_EMAIL=wattlab.support@gmail.com
SENDER_NAME=WattLab
# URL pubblico dell'app (per costruire i link di reset/verifica)
APP_URL=http://localhost:8080

# ─── Verifica email ───
# true = l'utente deve confermare l'email prima di poter accedere.
# Richiede BREVO configurato. Lascia false per il test iniziale.
REQUIRE_EMAIL_VERIFICATION=false

# ─── Cookies ───
COOKIE_DOMAIN=
COOKIE_SECURE=false
